<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:name=".settings.ModuleApplication"
        android:allowBackup="false" android:label="@string/module_name"
        android:icon="@drawable/ic_spectrum" android:supportsRtl="true"
        android:theme="@style/AppTheme" android:description="@string/module_description">
        <activity android:name=".settings.SettingsActivity" android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <receiver android:name=".settings.CaptureModeReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.wxxsfxyzm.hyperspectrum.NATIVE_AVAILABILITY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
